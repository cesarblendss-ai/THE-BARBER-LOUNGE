# Copy to .env.local and fill in real values locally / in Vercel.
# Never commit real keys.

# Admin
ADMIN_UPLOAD_KEY=

# Stripe (estimates + deposit Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: public site URL used in shareable estimate links
NEXT_PUBLIC_SITE_URL=

# GA4 measurement ID (public; set on Vercel Production)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Existing app env names (set in Vercel as needed)
DATABASE_URL=
NTFY_TOPIC=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE=
OPENAI_API_KEY=

# Vercel Cron auth for /api/cron/sync-booksy + refresh-availability (optional but recommended)
# Vercel may auto-inject CRON_SECRET on Pro; also accepts x-vercel-cron + admin key.
CRON_SECRET=

# Optional override for Booksy's *public* web-client API key (shipped in their JS bundle).
# Not a shop password — do NOT put Booksy Biz login credentials here.
# BOOKSY_WEB_API_KEY=
